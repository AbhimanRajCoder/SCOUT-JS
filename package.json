{
  "name": "scout-js",
  "version": "1.0.0",
  "description": "Zero-config runtime API documentation engine for Express.js",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js",
    "test": "node --test test/**/*.test.js",
    "example": "node examples/basic.js",
    "example:nested": "node examples/nested-routers.js"
  },
  "keywords": [
    "express",
    "openapi",
    "swagger",
    "documentation",
    "api-docs",
    "auto-docs",
    "fastapi",
    "rest",
    "api",
    "swagger-ui"
  ],
  "author": "Abhiman Raj <abhimaanraj90@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhimanraj/scout-js.git"
  },
  "bugs": {
    "url": "https://github.com/abhimanraj/scout-js/issues"
  },
  "homepage": "https://github.com/abhimanraj/scout-js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "express": "^4.21.1",
    "zod": "^4.6.7"
  }
}
